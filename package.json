{
  "name": "yejian-reader",
  "version": "0.1.24",
  "private": true,
  "description": "页间 · 跨设备阅读器（Web / PC / Android）",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pc": "vite build && electron .",
    "build:pc": "vite build && node scripts/build-windows.mjs",
    "build:mac:test": "vite build && electron-builder --mac --publish never",
    "build:linux:test": "vite build && electron-builder --linux AppImage deb --x64 --publish never",
    "build:android": "vite build && node scripts/sync-hybrid.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "mammoth": "^1.9.1",
    "marked": "^15.0.7",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.yejian.reader",
    "productName": "页间阅读",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "yejian-v${version}-windows-x64.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "artifactName": "yejian-v${version}-macos-test-${arch}.${ext}",
      "sign": "./scripts/sign-macos-test.cjs",
      "notarize": false,
      "hardenedRuntime": false
    },
    "linux": {
      "executableName": "yejian-reader",
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "itcwc <46277331+itcwc@users.noreply.github.com>",
      "artifactName": "yejian-v${version}-linux-test-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "displayLanguageSelector": true,
      "installerLanguages": ["zh_CN", "hi_IN", "pt_PT", "id_ID", "en_US", "tr_TR"],
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "itcwc",
        "repo": "yejian-reader"
      }
    ]
  },
  "keywords": [
    "reader",
    "ebook",
    "epub",
    "pdf",
    "webdav",
    "vue",
    "electron",
    "uniapp"
  ],
  "author": "itcwc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itcwc/yejian-reader.git"
  },
  "homepage": "https://github.com/itcwc/yejian-reader#readme",
  "bugs": {
    "url": "https://github.com/itcwc/yejian-reader/issues"
  }
}
